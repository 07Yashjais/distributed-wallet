# ============================================
# Distributed Wallet - Environment Variables
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?sslmode=require
DATABASE_SSL=true

# Cache & Rate Limiting (Redis)
# Local Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# Event Streaming (Apache Kafka)
# Local Docker KRaft: kafka:9092
KAFKA_BROKER=kafka:9092
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SASL_MECHANISM=plain

# Authentication
JWT_SECRET=<YOUR_SECURE_JWT_SECRET_KEY>

# CORS (Allowed origins, comma-separated or single URL)
# Local Frontend: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Frontend Client
VITE_API_URL=http://localhost:5000/api
