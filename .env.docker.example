# ============================================
# Distributed Wallet - Docker Environment Config
# ============================================

# Database Configuration (PostgreSQL)
DB_USER=wallet_user
DB_PASSWORD=wallet_password
DB_NAME=wallet_db
DATABASE_URL=postgresql://wallet_user:wallet_password@postgres:5432/wallet_db
DATABASE_SSL=false

# Redis Configuration
REDIS_URL=redis://redis:6379

# Apache Kafka Configuration
KAFKA_BROKER=kafka:29092

# Authentication
JWT_SECRET=distributed_wallet_secret_key_change_in_production

# CORS Configuration (* or http://localhost:3000,http://localhost:5173)
CORS_ORIGIN=*

# Frontend API Endpoint
VITE_API_URL=http://localhost:5000/api
